    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Models\nazvhi-flight.fbx">
      <Name>nazvhi-flight</Name>
      <Importer>FbxImporter</Importer>
      <Processor>ModelProcessor</Processor>
